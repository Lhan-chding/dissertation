+        ticks.append(True)
+        return dict(blocked=False, all_complete=False)
+
+    api.controller.tick = scientific_tick
+    assert driver.act() == "DISPATCHING_FIXED_TASKS"
+    assert len(api.amendments) == len(api.freezes) == len(ticks) == 1
