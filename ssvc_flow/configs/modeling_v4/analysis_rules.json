{
  "version": "v4-analysis-rules-20260916-1",
  "frozen_before_new_v4_measurements": true,
  "purpose": "Explicit engineering overlap screens and descriptive reference precision labels",
  "reference_precision": {
    "probability_scales": [0.00025, 0.001, 0.005],
    "normal_approximation_multiplier": 1.96,
    "max_half_width_as_fraction_of_scale": 0.5,
